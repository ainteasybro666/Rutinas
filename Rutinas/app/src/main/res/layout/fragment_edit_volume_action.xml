<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ajustar Volumen"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Media Volume -->
    <TextView
        android:id="@+id/tvMediaVolumeValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/media_volume"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cbVolumeMedia" />

    <CheckBox
        android:id="@+id/cbVolumeMedia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/tvMediaVolumeValue"
        app:layout_constraintBottom_toBottomOf="@id/tvMediaVolumeValue"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/seekBarMediaVolume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvMediaVolumeValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ringtone Volume -->
    <TextView
        android:id="@+id/tvRingtoneVolumeValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ringtone_volume"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/seekBarMediaVolume"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cbVolumeRingtone" />

    <CheckBox
        android:id="@+id/cbVolumeRingtone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/tvRingtoneVolumeValue"
        app:layout_constraintBottom_toBottomOf="@id/tvRingtoneVolumeValue"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/seekBarRingtoneVolume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvRingtoneVolumeValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Alarm Volume -->
    <TextView
        android:id="@+id/tvAlarmVolumeValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/alarm_volume"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/seekBarRingtoneVolume"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cbVolumeAlarm" />

    <CheckBox
        android:id="@+id/cbVolumeAlarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/tvAlarmVolumeValue"
        app:layout_constraintBottom_toBottomOf="@id/tvAlarmVolumeValue"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/seekBarAlarmVolume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvAlarmVolumeValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/save"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/seekBarAlarmVolume"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>