<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvVolumeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configure Volume Action"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Media Volume Controls -->
    <CheckBox
        android:id="@+id/cbVolumeMedia"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Multimedia Volume"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvVolumeTitle" />

    <SeekBar
        android:id="@+id/seekBarMediaVolume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="50"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cbVolumeMedia"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvMediaVolumeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="50%"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/seekBarMediaVolume"
        app:layout_constraintTop_toBottomOf="@+id/seekBarMediaVolume"
        tools:visibility="visible" />

    <!-- Ringtone Volume Controls -->
    <CheckBox
        android:id="@+id/cbVolumeRingtone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ringtone Volume"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMediaVolumeValue" />

    <SeekBar
        android:id="@+id/seekBarRingtoneVolume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="50"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cbVolumeRingtone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvRingtoneVolumeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="50%"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/seekBarRingtoneVolume"
        app:layout_constraintTop_toBottomOf="@+id/seekBarRingtoneVolume"
        tools:visibility="visible" />

    <!-- Alarm Volume Controls -->
    <CheckBox
        android:id="@+id/cbVolumeAlarm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Alarm Volume"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvRingtoneVolumeValue" />

    <SeekBar
        android:id="@+id/seekBarAlarmVolume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="50"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cbVolumeAlarm"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvAlarmVolumeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="50%"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/seekBarAlarmVolume"
        app:layout_constraintTop_toBottomOf="@+id/seekBarAlarmVolume"
        tools:visibility="visible" />

    <!-- Buttons -->
    <Button
        android:id="@+id/btnCancelVolumeAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnSaveVolumeAction"
        app:layout_constraintTop_toBottomOf="@+id/tvAlarmVolumeValue" />

    <Button
        android:id="@+id/btnSaveVolumeAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp"
        android:text="Save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAlarmVolumeValue" />

</androidx.constraintlayout.widget.ConstraintLayout>
