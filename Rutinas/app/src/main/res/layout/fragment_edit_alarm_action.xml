<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_alarm_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Configurar Alarma"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Action Label/Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_alarm_action_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Etiqueta"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
    app:layout_constraintTop_toBottomOf="@id/tv_alarm_title"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_alarm_action_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textCapWords" />

</com.google.android.material.textfield.TextInputLayout>

    <!-- Alarm Sound Selection -->
<com.google.android.material.textfield.TextInputLayout
android:id="@+id/til_alarm_sound"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginTop="16dp"
android:hint="Sonido de Alarma"
style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
    app:layout_constraintTop_toBottomOf="@id/til_alarm_action_label"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

<AutoCompleteTextView
android:id="@+id/actv_alarm_sound"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="none"
android:cursorVisible="false"
android:focusable="false"
android:focusableInTouchMode="false"
android:clickable="true"
    android:drawableEnd="@drawable/ic_arrow_drop_down" tools:ignore="UseCompatDrawableXml" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Vibration Pattern Selection -->
<com.google.android.material.textfield.TextInputLayout
android:id="@+id/til_vibration_pattern"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginTop="8dp"
android:hint="Patrón de Vibración"
style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
    app:layout_constraintTop_toBottomOf="@id/til_alarm_sound"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

<AutoCompleteTextView
android:id="@+id/actv_vibration_pattern"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:inputType="none"
android:cursorVisible="false"
android:focusable="false"
android:focusableInTouchMode="false"
android:clickable="true"
    android:drawableEnd="@drawable/ic_arrow_drop_down" tools:ignore="UseCompatDrawableXml" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Duration Selection -->
<TextView
android:id="@+id/tvDurationLabel"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="16dp"
android:text="Duración"
android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/til_vibration_pattern" />

<Spinner
android:id="@+id/etDuration"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:entries="@array/duration_presets"
android:background="@drawable/spinner_background"
    android:padding="12dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/tvDurationLabel" />


    <!-- Repetitions Selection -->
<TextView
android:id="@+id/tvRepetitionsLabel"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="16dp"
android:text="Repeticiones"
android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/etDuration" />

<Spinner
android:id="@+id/etRepetitions"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:entries="@array/repetition_counts"
android:background="@drawable/spinner_background"
    android:padding="12dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/tvRepetitionsLabel" />

    <!-- Switches Section -->
<LinearLayout
android:id="@+id/ll_switches"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:orientation="vertical"
android:layout_marginTop="24dp"
app:layout_constraintTop_toBottomOf="@id/etRepetitions"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent">

<!-- Ignore Do Not Disturb -->
<com.google.android.material.switchmaterial.SwitchMaterial
    android:id="@+id/switch_ignore_dnd"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Ignorar No Molestar"
    android:paddingVertical="8dp"/>

<!-- Only Vibration -->
<com.google.android.material.switchmaterial.SwitchMaterial
    android:id="@+id/switch_only_vibration"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Solo vibración"
    android:paddingVertical="8dp"/> <!-- Added vertical padding -->

<!-- Stop on Tap -->
<com.google.android.material.switchmaterial.SwitchMaterial
    android:id="@+id/switch_stop_on_tap"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="Detener al tocar"
    android:paddingVertical="8dp"/> <!-- Added vertical padding -->

</LinearLayout>

    <!-- Your existing button container (can be removed if using standard AlertDialog buttons) -->
<LinearLayout
android:layout_width="0dp"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:gravity="end"
android:layout_marginTop="24dp"
app:layout_constraintTop_toBottomOf="@id/ll_switches"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent">

<!-- Buttons are typically handled by the AlertDialog itself, you might not need this LinearLayout if you're using the standard buttons -->

</LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
